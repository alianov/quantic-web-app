:80 {
	encode gzip zstd

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# This route checks the web container only. Flask has separate health routes.
	handle /healthz {
		respond 200
	}

	# Handle API paths before the React fallback, or errors may return index.html.
	# Keep requests same-origin and limit the small JSON form submissions.
	@api path /api/*
	handle @api {
		request_body {
			max_size 32KB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Unknown browser paths return the React entry point for client routing.
		try_files {path} /index.html
		file_server
	}
}
