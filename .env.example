COMPOSE_PROJECT_NAME=cafe-fausse
BIND_ADDRESS=127.0.0.1

WEB_DEV_PORT=5173
# HTTP redirects to the HTTPS port below in production-like demo mode.
WEB_PORT=8080
WEB_HTTPS_PORT=9443
API_PORT=8000
POSTGRES_PORT=5432
ADMINER_PORT=8091

POSTGRES_DB=cafe_fausse
POSTGRES_USER=cafe_fausse
# Local development only. Replace this value before any shared deployment.
POSTGRES_PASSWORD=cafe_fausse_dev
POSTGRES_IMAGE_TAG=18.6-bookworm
POSTGRES_PGDATA=/var/lib/postgresql/18/docker
POSTGRES_VOLUME_NAME=cafe-fausse-postgres-18

RESTAURANT_TIMEZONE=America/New_York
RESERVATION_SLOT_MINUTES=30
